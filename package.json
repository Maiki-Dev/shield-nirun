{
  "name": "shieldnirun-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "dev:preview": "NEXT_DIST_DIR=.next-preview next dev -p 3001",
    "prisma": "node --env-file-if-exists=.env.local ./node_modules/prisma/build/index.js",
    "db:migrate": "npm run prisma -- migrate dev",
    "db:deploy": "npm run prisma -- migrate deploy",
    "db:seed": "node --env-file-if-exists=.env.local ./node_modules/tsx/dist/cli.mjs prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "bcryptjs": "2.4.3",
    "framer-motion": "^11.11.17",
    "lenis": "1.3.26",
    "lucide-react": "0.460.0",
    "next": "14.2.35",
    "next-themes": "^0.3.0",
    "prisma": "5.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "server-only": "0.0.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "tsx": "4.19.2",
    "typescript": "^5.6.3"
  }
}
