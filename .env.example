# PostgreSQL connection (production: a dedicated database and user)
DATABASE_URL="postgresql://shieldnirun:CHANGE_ME@localhost:5432/shieldnirun"
# Persistent folder for admin uploads (outside the app folder, included in backups)
UPLOAD_DIR="/var/lib/shieldnirun/uploads"
# Private uploads (job-application CVs) — never served publicly
PRIVATE_UPLOAD_DIR="/var/lib/shieldnirun/private"
# First admin account — only used by `npm run db:seed` when no users exist yet. Remove after first login.
ADMIN_EMAIL="you@shieldnirun.mn"
ADMIN_NAME="Your Name"
ADMIN_PASSWORD="at-least-10-characters"
